}
def sypher(text):
    result = []
    for i in text:
        if i in symbol:
            index = symbol[i]
            new_index = 100 - index
            result.append(str(new_index))
        else:
            result.append(i)
    return " ".join(result)

def obrat_cypher(encrypted_text):
    reverse_symbol = {value: key for key, value in symbol.items()}
    result = []
    items = encrypted_text.split()
    for item in items:
        if item.isdigit() or (item.startswith('-') and item[1:].isdigit()):
            num = int(item)
            original_index = 100 - num
            if original_index in reverse_symbol:
                result.append(reverse_symbol[original_index])
            else:
                result.append(item)
        else:
            result.append(item)
    return "".join(result)


